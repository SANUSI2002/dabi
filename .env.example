# Local remains the safe default while the Sabi backend is in development.
VITE_REVENUE_CYCLE_MODE=local

# Configure these only when the authenticated revenue-cycle API is available.
# VITE_REVENUE_CYCLE_MODE=api
# VITE_REVENUE_CYCLE_API_URL=https://api.example.test
# Required for real backend services. When omitted, service calls fail with an
# explicit unavailable error; production never falls back to fixture data.
# VITE_API_BASE_URL=https://api.sabihealth.example

# Development only. Set false to audit empty/unavailable states locally.
# Production builds always ignore fixtures.
# VITE_ENABLE_DEV_FIXTURES=false

# Existing patient/telemedicine sign-in. Patient-facing CTAs redirect here;
# the hospital Sabi ID sign-in remains separate.
# VITE_TELEMEDICINE_SIGN_IN_URL=https://care.sabihealth.example/login

# Development storefront preview target. Production marketplace discovery is
# served by VITE_API_BASE_URL and does not use the preview handoff.
# VITE_PATIENT_PORTAL_URL=http://127.0.0.1:5174

# Set these separately in each Vercel project once the real domain is known.
# VITE_SABI_HEALTH_URL=https://www.example.com
# VITE_SABI_EMR_URL=https://emr.example.com
# VITE_SABI_PHARMACY_URL=https://pharmacy.example.com
# VITE_SABI_COMMAND_CENTER_URL=https://command.example.com
# VITE_SABI_TELEMEDICINE_URL=https://care.example.com
# VITE_TELEMEDICINE_SIGN_IN_URL=https://care.example.com/login
# VITE_HOSPITAL_ONBOARDING_URL=https://www.example.com/register/organization
