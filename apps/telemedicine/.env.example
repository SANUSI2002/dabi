VITE_HOSPITAL_ONBOARDING_URL=http://127.0.0.1:5173/register/organization
# Central Sabi Identity API origin (no trailing /api path). Same-site subdomains
# are required for shared browser SSO after deployment.
# VITE_SABI_IDENTITY_API_URL=https://api.example.com
# Use VITE_SABI_IDENTITY_API_URL=same-origin when the deployment proxies /api.
# For local testing from the patient portal package, set in its own
# .env.development.local and use its same-origin Vite proxy:
# VITE_SABI_IDENTITY_API_URL=http://127.0.0.1:5174
# SABI_DEV_API_TARGET=https://your-test-api.onrender.com
# Main Sabi frontend origin hosting /identity/mfa (no trailing slash).
# VITE_SABI_IDENTITY_UI_URL=https://www.example.com
