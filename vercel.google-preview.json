{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:health",
  "outputDirectory": "dist-health",
  "installCommand": "npm ci && npm ci --prefix apps/telemedicine",
  "build": {
    "env": {
      "VITE_SABI_IDENTITY_API_URL": "same-origin",
      "VITE_API_BASE_URL": "same-origin",
      "VITE_SABI_HEALTH_URL": "",
      "VITE_SABI_TELEMEDICINE_URL": "",
      "VITE_SABI_DOCTOR_URL": "/telemedicine/doctor-portal",
      "VITE_SABI_EMR_URL": "",
      "VITE_SABI_PHARMACY_URL": "",
      "VITE_SABI_COMMAND_CENTER_URL": "",
      "VITE_TELEMEDICINE_SIGN_IN_URL": "/telemedicine/login",
      "VITE_HOSPITAL_ONBOARDING_URL": "/register/organization"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sabi-api-production-556396127853.us-east1.run.app/api/:path*" },
    { "source": "/telemedicine/doctor-portal/:path*", "destination": "/telemedicine/doctor-portal/index.html" },
    { "source": "/telemedicine/:path*", "destination": "/telemedicine/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
